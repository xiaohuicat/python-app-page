  <property name="styleSheet">
   <string notr="true">#tips {
	color: #fff;
	background-color: #666;
	padding: 5px;
	border-radius: 8px;
}

* {
  padding:0;
  margin:0;
  border:none;
  outline: none;
}

/* 垂直滚动条 handle */
QScrollBar::handle::vertical{
  background: #fff;
  width: 4px;
  border-radius: 2px;
}
QScrollBar::handle::vertical:hover{
  background: #fff; 
}
/* 垂直滚动条 区域 */
QScrollBar::vertical{
  border-color: rgba(255, 255, 255, 10%);
  width: 4px;
  border-radius: 2px;
}
/* 垂直滚动条  handle上、下区域（未被handle占用的区域） */
QScrollBar::add-page::vertical, QScrollBar::sub-page::vertical,QScrollBar::add-line::vertical,QScrollBar::sub-line::vertical{
  border:none;
  outline:none;
}

/* 水平滚动条 handle */
QScrollBar::handle:horizontal{
  background: #fff;
  height: 4px;
  border-radius: 2px;
}
/* 水平滚动条 handle */
QScrollBar::handle:horizontal::hover{
  background: #fff; 
}
/* 水平滚动条 区域 */
QScrollBar:horizontal{
  /* border-color: rgba(255, 255, 255, 10%); */
  height: 4px;
  border-radius: 2px;
  /* margin: 5px; */
}
/* 水平滚动条  handle上、下区域（未被handle占用的区域） */
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal,QScrollBar::add-line:horizontal,QScrollBar::sub-line:horizontal{
  border:none;
  outline:none;
}

</string>
  </property>
