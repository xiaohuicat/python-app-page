* {
    padding: 0;
    margin: 0;
    border: none;
    outline: none;
}

QLabel {
    color: #333;
    font-size: 14px;
    font-family: 微软雅黑;
}

/* 按钮样式 */
QPushButton {
    color: #333;
    border: none;
    border-radius: 5px;
    background-color: transparent;
    font-size: 14px;
}

/* 单行输入框 */
QLineEdit {
    color: #333;
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    padding: 6px 8px;
    background-color: #fff;
    font-size: 14px;
}
QLineEdit:hover {
    border-color: #ccc;
}
QLineEdit:focus {
    border-color: #409eff;
}
QLineEdit:disabled {
    background-color: #f8f8f8;
    color: #999;
}

/* 多行文本框 */
QTextEdit {
    color: #333;
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    padding: 8px;
    background-color: #fff;
    font-size: 14px;
}
QTextEdit:hover {
    border-color: #ccc;
}
QTextEdit:focus {
    border-color: #409eff;
}

/* 下拉框 */
QComboBox {
    color: #333;
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    padding: 6px 8px;
    background-color: #fff;
    font-size: 14px;
    min-height: 30px;
}
QComboBox:hover {
    border-color: #ccc;
}
QComboBox:focus {
    border-color: #409eff;
}
/* 下拉框弹出列表 */
QComboBox QAbstractItemView {
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    padding: 4px;
    background-color: #fff;
    selection-background-color: #e8f4ff;
    selection-color: #333;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: url(:/icons/arrow-down.png); /* 可替换为自己的下拉箭头图标 */
    width: 10px;
    height: 10px;
}

/* 复选框 */
QCheckBox {
    color: #333;
    font-size: 14px;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #e0e0e0;
    border-radius: 3px;
    background-color: #fff;
}
QCheckBox::indicator:hover {
    border-color: #ccc;
}
QCheckBox::indicator:checked {
    background-color: #409eff;
    border-color: #409eff;
    image: url(:/icons/check.png); /* 可替换为自己的对勾图标 */
    background-position: center;
    background-repeat: no-repeat;
}
QCheckBox:disabled {
    color: #999;
}
QCheckBox:disabled::indicator {
    background-color: #f8f8f8;
    border-color: #ddd;
}

/* 单选按钮 */
QRadioButton {
    color: #333;
    font-size: 14px;
    spacing: 6px;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    background-color: #fff;
}
QRadioButton::indicator:hover {
    border-color: #ccc;
}
QRadioButton::indicator:checked {
    background-color: #409eff;
    border-color: #409eff;
}
QRadioButton::indicator:checked::before {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: #fff;
    margin: 3px;
}

/* 列表控件 */
QListWidget {
    color: #333;
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    background-color: #fff;
}
QListWidget::item {
    padding: 6px 8px;
}
QListWidget::item:hover {
    background-color: #f5f5f5;
}
QListWidget::item:selected {
    background-color: #e8f4ff;
    color: #333;
}

/* 表格控件 */
QTableWidget {
    color: #333;
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    background-color: #fff;
    gridline-color: #e0e0e0;
}
QTableWidget::item {
    padding: 6px;
}
QTableWidget::item:selected {
    background-color: #e8f4ff;
    color: #333;
}
QTableWidget::horizontalHeader {
    background-color: #f8f8f8;
}
QTableWidget::horizontalHeader::section {
    border: none;
    border-bottom: 1px solid #e0e0e0;
    padding: 6px;
}

/* 滚动条 */
/* 垂直滚动条 */
QScrollBar::vertical {
  width: 8px;
  border-radius: 4px;
  background-color: transparent;
}
QScrollBar::handle:vertical {
  background: #f0f0f0;
  width: 8px;
  border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
  background: #fff;
}
QScrollBar::add-page:vertical, 
QScrollBar::sub-page:vertical,
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  border: none;
  background-color: transparent;
}

/* 水平滚动条 */
QScrollBar:horizontal {
  height: 8px;
  border-radius: 4px;
  background-color: transparent;
}
QScrollBar::handle:horizontal {
  background: #f0f0f0;
  height: 8px;
  border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
  background: #fff;
}
QScrollBar::add-page:horizontal, 
QScrollBar::sub-page:horizontal,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
  border: none;
  background-color: transparent;
}

/* 滚动页面默认无背景 */
QScrollArea {
  background-color: transparent;
}